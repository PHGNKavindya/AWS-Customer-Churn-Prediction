# AWS Customer Churn Prediction - Environment Configuration Template
# Copy this file to .env and populate with your own environment values.
# NEVER commit credentials, secret keys, or account IDs to version control.

# AWS Region Configuration
AWS_DEFAULT_REGION=ap-southeast-2

# Amazon S3 Bucket Names (Replace with your actual bucket)
S3_BUCKET_NAME=customer-churn-analytics-ash1010-2026
S3_PROCESSED_DATA_PREFIX=processed/
S3_MODEL_OUTPUT_PREFIX=model/
S3_PREDICTIONS_PREFIX=predictions/

# AWS Athena Configuration
ATHENA_DATABASE_NAME=customer_churn_db
ATHENA_TABLE_NAME=customer_churn
ATHENA_OUTPUT_LOCATION=s3://customer-churn-analytics-ash1010-2026/athena-query-results/

# AWS SageMaker Configuration
SAGEMAKER_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/CustomerChurnSageMakerExecutionRole
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge

# Dashboard Local Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
DATA_PATH=data/processed/customer_churn_cleaned.csv
MODEL_PATH=data/output/final_churn_model.joblib
THRESHOLD_PATH=data/output/final_churn_threshold.joblib
